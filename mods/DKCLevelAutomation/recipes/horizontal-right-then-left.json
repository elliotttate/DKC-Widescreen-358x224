{
  "schema": 1,
  "name": "horizontal-right-then-left",
  "description": "From the same Jungle state, run right and then left with exact P1 input and collect tilemap checkpoints through both horizontal streaming directions.",
  "tilemapLayers": "1,2",
  "watches": [
    {"name":"camera_x","address":"0x7E1A62","size":2,"signed":false,"units":"pixels","source":"DKC1 RAM map: Level_CameraXPos"},
    {"name":"camera_y","address":"0x7E1A4C","size":2,"signed":false,"units":"pixels","source":"DKC1 RAM map: Level_CameraYPos"},
    {"name":"layer1_x","address":"0x7E088B","size":2,"signed":false,"units":"pixels","source":"DKC1 RAM map: Global_Layer1XPos"},
    {"name":"layer1_y","address":"0x7E0895","size":2,"signed":false,"units":"pixels","source":"DKC1 RAM map: Global_Layer1YPos"},
    {"name":"sprite0_x","address":"0x7E0B19","size":2,"signed":true,"units":"pixels","source":"DKC1 RAM map: NorSpr_XPos slot 0"},
    {"name":"sprite0_y","address":"0x7E0BC1","size":2,"signed":true,"units":"pixels","source":"DKC1 RAM map: NorSpr_YPos slot 0"},
    {"name":"sprite1_x","address":"0x7E0B1B","size":2,"signed":true,"units":"pixels","source":"DKC1 RAM map: NorSpr_XPos slot 1"},
    {"name":"sprite1_y","address":"0x7E0BC3","size":2,"signed":true,"units":"pixels","source":"DKC1 RAM map: NorSpr_YPos slot 1"},
    {"name":"p1_held","address":"0x7E0500","size":2,"signed":false,"source":"DKC1 RAM map: Global_HeldButtons P1"}
  ],
  "steps": [
    {"kind":"automation","command":"load_rom","args":{"path":"${ROM}","load_last_state":false}},
    {"kind":"automation","command":"load_state_file","args":{"path":"${STATE}"}},
    {"kind":"automation","command":"schedule","args":{"controller":1,"macro":"0-89=RIGHT+Y;90-105=NONE"}},
    {"kind":"checkpoint","label":"horizontal-start","capture":true},
    {"kind":"automation","command":"run_frames","args":{"count":32,"timeout_ms":15000}},
    {"kind":"checkpoint","label":"right-f032","capture":true},
    {"kind":"automation","command":"run_frames","args":{"count":32,"timeout_ms":15000}},
    {"kind":"checkpoint","label":"right-f064","capture":true},
    {"kind":"automation","command":"run_frames","args":{"count":42,"timeout_ms":15000}},
    {"kind":"checkpoint","label":"right-settled-f106","capture":true},
    {"kind":"automation","command":"schedule","args":{"controller":1,"macro":"0-89=LEFT+Y;90-105=NONE"}},
    {"kind":"automation","command":"run_frames","args":{"count":32,"timeout_ms":15000}},
    {"kind":"checkpoint","label":"left-f032","capture":true},
    {"kind":"automation","command":"run_frames","args":{"count":32,"timeout_ms":15000}},
    {"kind":"checkpoint","label":"left-f064","capture":true},
    {"kind":"automation","command":"run_frames","args":{"count":42,"timeout_ms":15000}},
    {"kind":"checkpoint","label":"left-settled-f106","capture":true}
  ]
}
